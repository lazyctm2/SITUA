# Frontend environment variables for Vite
# Copy this file to .env and update values locally.

VITE_API_URL=http://localhost:3000
VITE_USE_HTTPS=false
VITE_SSL_KEY=./ssl/localhost-key.pem
VITE_SSL_CERT=./ssl/localhost.pem

# Para publicar en GitHub Pages, configura el secreto del repositorio `VITE_API_URL`
# con la URL pública del backend antes de desplegar.
