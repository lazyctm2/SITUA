# Local development environment variables
# Copy this file to .env and update values locally.

PORT=3000
USE_HTTPS=false
SSL_KEY_PATH=./ssl/10.40.63.9+1-key.pem
SSL_CERT_PATH=./ssl/10.40.63.9+1.pem

# PostgreSQL connection settings
# Use DATABASE_URL for a single connection string.
DATABASE_URL=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=walking_alerts
DB_SSL=false
